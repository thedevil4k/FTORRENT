# The style the tree uses, and the one the editors must produce.
#
# The tree is formatted with this file: `clang-format --dry-run` over src/
# and tests/ reports nothing. A file that outgrew the limit is split by
# topic, never reformatted on the way, and a whole-tree formatting pass is
# its own commit, never mixed with a behaviour change.
#
# The settings below are the ones the code was already written in, found by
# asking which choice leaves the smallest patch over the whole tree. Where
# the tree had no opinion, the choice is stated here in a comment.
BasedOnStyle: LLVM
Language: Cpp
Standard: c++20

IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 80

# The opening brace sits on the same line as what it opens, for functions as
# well as for the records and namespaces around them.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: false
  AfterClass: false
  AfterStruct: false
  AfterEnum: false
  AfterNamespace: false
  AfterUnion: false
  AfterExternBlock: false
  AfterControlStatement: Never
  BeforeElse: false
  BeforeCatch: false
  SplitEmptyFunction: true
  SplitEmptyRecord: false
  SplitEmptyNamespace: true

# `public:` sits at column 0, the members are indented inside it.
AccessModifierOffset: -4

PointerAlignment: Left
ReferenceAlignment: Pointer
AlignAfterOpenBracket: Align
AlignOperands: Align
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: AllIfsAndElse
AllowShortLoopsOnASingleLine: true
AllowShortBlocksOnASingleLine: Empty
AllowShortLambdasOnASingleLine: All
AllowShortCaseLabelsOnASingleLine: false
BreakConstructorInitializers: BeforeComma
ConstructorInitializerIndentWidth: 4
ContinuationIndentWidth: 4
DerivePointerAlignment: false
IndentCaseLabels: true
IndentPPDirectives: None
MaxEmptyLinesToKeep: 1
NamespaceIndentation: None
# The include order is the one the reader expects: the project's own
# headers first, then the library ones, then the standard ones.
SortIncludes: Never
SpaceBeforeParens: ControlStatements
ReflowComments: true
